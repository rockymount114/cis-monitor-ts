# MSSQL
DB_SERVER=
DB_DATABASE=
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Schedule (6am, 11am, 19:20, 10pm)
TIME_ZONE=America/New_York
CRON_TIMES=0 6 * * *,0 11 * * *,20 19 * * *,0 22 * * *
# Optional override for checkpoints & cumulative expected jobs:
# SCHEDULE_CHECKPOINTS=06:00:6:0 6 * * *,11:00:7:0 11 * * *,19:20:8:20 19 * * *,22:00:9:0 22 * * *
# Or parallel expected counts matching CRON_TIMES:
# EXPECTED_JOB_COUNTS=6,7,8,9

# Notifications
SMTP_HOST=smtp.office365.com
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
NOTIFY_FROM=
NOTIFY_TO=
TEAMS_WEBHOOK_URL=

# Network Check
CIS_SERVER=
CIS_PORTS=3389,443,80,81,1433

# Telegram Bot (for notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=